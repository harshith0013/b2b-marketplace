# Copy to .env to override docker-compose defaults. Local development only.
POSTGRES_USER=b2b_app
POSTGRES_PASSWORD=local_dev_only

# Encrypts the website's sign-in cookie. Use a long random value outside local development:
#   openssl rand -base64 32
SESSION_SECRET=local-dev-only-session-secret-0123456789

# Real Google sign-in (only with docker-compose.google.yml). From Google Cloud console →
# APIs & Services → Credentials → your OAuth client. Never commit the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local only: the email you sign in with becomes a platform admin (to try the review queue).
# Leave empty in any shared or deployed environment; see docs/admin-setup.md.
BOOTSTRAP_ADMIN_EMAIL=

# Search engines are asked not to index the site until the pilot. Set to true (when building the
# website) once the product name and prices may appear in search results.
SITE_INDEXABLE=false

# Search assistant (Phase 7): a Google Gemini API key from Google AI Studio (free tier works, with
# small daily limits). Leave empty to run without the assistant. Never commit the real key.
GEMINI_API_KEY=
# Label photos read per day (Phase 8), counted apart from assistant questions.
AI_VISION_DAILY_LIMIT=100
