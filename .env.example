# Copy to .env to override docker-compose defaults. Local development only.
POSTGRES_USER=b2b_app
POSTGRES_PASSWORD=local_dev_only

# Encrypts the website's sign-in cookie. Use a long random value outside local development:
#   openssl rand -base64 32
SESSION_SECRET=local-dev-only-session-secret-0123456789

# Real Google sign-in (only with docker-compose.google.yml). From Google Cloud console →
# APIs & Services → Credentials → your OAuth client. Never commit the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
