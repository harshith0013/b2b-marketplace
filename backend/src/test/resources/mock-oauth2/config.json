{
  "interactiveLogin": true,
  "tokenCallbacks": [
    {
      "issuerId": "default",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "email_verified",
          "match": "false",
          "claims": {
            "sub": "${user_sub}",
            "email": "${email}",
            "email_verified": false,
            "aud": ["b2b-marketplace-web"]
          }
        },
        {
          "requestParam": "grant_type",
          "match": "client_credentials",
          "claims": {
            "sub": "${user_sub}",
            "email": "${email}",
            "email_verified": true,
            "aud": ["b2b-marketplace-web"]
          }
        },
        {
          "requestParam": "subject",
          "match": ".*",
          "claims": {
            "email": "${subject}",
            "email_verified": true,
            "aud": ["b2b-marketplace-web"]
          }
        }
      ]
    }
  ]
}
